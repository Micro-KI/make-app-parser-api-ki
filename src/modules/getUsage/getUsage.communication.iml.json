{
    "url": "/usage",
    "method": "GET",
    "qs": {
        "type": "{{ifempty(parameters.type, omit)}}"
    },
    "response": {
        "iterate": "{{body.entries}}",
        "output": {
            "{{...}}": "{{item}}",
            "ts": "{{parseDate(item.ts; 'YYYY-MM-DDTHH:mm:ssZ')}}"
        },
        "limit": "{{parameters.limit}}"
    }
}
